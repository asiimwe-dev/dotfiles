<?xml version="1.0"?>
<ruleset name="Nvim default">
    <description>PSR-12 tuned for PHP templates. Used by nvim-lint when a project has no phpcs ruleset of its own.</description>

    <rule ref="PSR12">
        <!-- Alternative syntax in views: foreach (...): ?> -->
        <exclude name="Squiz.ControlStructures.ControlSignature.SpaceAfterCloseParenthesis"/>
        <!-- Long Tailwind class lines; the formatter never wraps them anyway -->
        <exclude name="Generic.Files.LineLength"/>
    </rule>
</ruleset>
